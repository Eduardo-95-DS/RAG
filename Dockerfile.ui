# Thin Streamlit UI image (item 8): streamlit + requests ONLY — no langchain,
# no faiss, no flashrank, no torch, no vertex. A fraction of the API image.
# The UI holds no pipeline code; it POSTs to the rag-api backend (BACKEND_URL).
FROM python:3.13-slim

COPY --from=ghcr.io/astral-sh/uv:0.11.23 /uv /uvx /bin/

WORKDIR /app

ENV UV_PYTHON_DOWNLOADS=0
ENV UV_LINK_MODE=copy

# Install ONLY the `ui` dependency group (streamlit + requests). --no-install-project
# because the thin streamlit_app.py imports nothing from src.* — it's a plain
# script, so the project package doesn't need installing here. This is what keeps
# the UI image small and avoids the uv --only-group + project-install conflict.
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --only-group ui --no-install-project --no-cache

# Only the UI script is needed (not the whole src/ tree).
COPY streamlit_app.py ./

# Run streamlit from the synced venv directly. Using the venv binary (not
# `uv run`, which would try to reconcile the full project/default groups)
# keeps this to just the `ui` group installed above.
ENV PATH="/app/.venv/bin:$PATH"

# BACKEND_URL (the rag-api service URL) and API_KEY are injected at deploy time.
ENV PORT=8080
EXPOSE 8080

CMD ["sh", "-c", "streamlit run streamlit_app.py --server.port=$PORT --server.address=0.0.0.0 --server.headless=true"]
